let 
    # l ← cons 5 ( cons 4 ( cons 3 ( cons 2 ( cons 1 null ) ) ) ) ;
    l <- cons 1 null ;
    # l <- null ;

    fold <- λ f . λ start . fix r . λ l . match ( out l ) { 
        inL unit → dres_now start ;
        inR tup → dres_func2_1 f ( fst tup ) ( r ⊙ snd tup )
    } ;

    # fix r . λ l . match ( out l ) { 
    #     inL unit → dres_now 0 ;
    #     inR tup → dres_func2_1 add ( fst tup ) ( r ⊙ snd tup )
    # } 

    # f <- dres_func2 add ;
    # x <- dres_now 1 ;
    # y <- dres_delay 2 ;
    x1 <- dres_delay (dres_now 1);

in: force (dres_map (\x . x + 1) x1)
# in: f x y
# in: force (fold add 0 l)
