# in: a + b + c

# evalExp(
# LetIn
# |
# +- Assignment List
# |  |
# |  +- Assignment
# |  |  |
# |  |  +- a (1)
# |  |  |
# |  |  `- 1
# |  |
# |  `- Assignment
# |     |
# |     +- b (1)
# |     |
# |     `- a (1)
# |
# `- Add
#    |
#    +- LetIn
#    |  |
#    |  +- Assignment List
#    |  |  |
#    |  |  +- Assignment
#    |  |  |  |
#    |  |  |  +- a (1)
#    |  |  |  |
#    |  |  |  `- 1
#    |  |  |
#    |  |  `- Assignment
#    |  |     |
#    |  |     +- b (1)
#    |  |     |
#    |  |     `- a (1)
#    |  |
#    |  `- b (1)
#    |
#    `- 1
# )
# = 2

let
    a <- let
        a <- 1;
        b <- a;
    in: b;
    b <- a + 1;
in: a
