-- Syntax of GHOPFL defined in LBNF format
-- To be processed into a parser and lexer using BNFC

-- Environment is entrypoint to enable parsing of envs from the command line
entrypoints Exp, Environment;

comment     "#" ;

token       Lam     ('λ' | '\\') ;
token       Conj    ('∧' | 'a''n''d') ;
token       Disj    ('∨' | 'o''r') ;
token       TNot    ('¬' | '!') ;
token       TLeq    ('≤' | '<''=') ;
token       TGeq    ('≥' | '>''=') ;
token       TLApp   ('⊙' | '(''*'')') ;
token       TSub    ('←' | '<''-') ;
token       TMatch  ('→' | '-''>') ;
token       TSingle ( '𝟙' | '{''*''}' ) ;

BTrue.      Exp14   ::= "true" ;
Single.     Exp14   ::= TSingle ;
Var.        Exp14   ::= Ident ;
DVal.       Exp14   ::= Double ;
IVal.       Exp14   ::= Integer ;
BFalse.     Exp14   ::= "false" ;
Rand.       Exp14   ::= "rand" ;
Pair.       Exp13   ::= "(" Exp13 "," Exp14 ")" ;
Next.       Exp13   ::= "next" Exp14 ;
Prev.       Exp13   ::= "prev" "{" Environment "}" "." Exp13 ;
-- Syntactic sugar for empty substitution list
PrevE.      Exp13   ::= "prev" Exp14;
-- Syntactic sugar for prev{\x ← \x}.t with \x being all free vars in t
PrevI.      Exp13   ::= "prevI" Exp14;
Box.        Exp13   ::= "box" "{" Environment "}" "." Exp13 ;
BoxI.       Exp13   ::= "boxI" Exp14 ;
Unbox.      Exp13   ::= "unbox" Exp14 ;
Force.      Exp13   ::= "force" Exp14 ;
In.         Exp12   ::= "in" Exp13 ;
Out.        Exp12   ::= "out" Exp13 ;
Fst.        Exp12   ::= "fst" Exp13 ;
Snd.        Exp12   ::= "snd" Exp13 ;
InL.        Exp12   ::= "inL" Exp13 ;
InR.        Exp12   ::= "inR" Exp13 ;
App.        Exp11   ::= Exp11 Exp12 ;
LApp.       Exp11   ::= Exp11 TLApp Exp12;
Min.        Exp10   ::= "-" Exp11 ;
Pow.        Exp9    ::= Exp9 "^" Exp10 ;
Mul.        Exp8    ::= Exp8 "*" Exp9 ;
Div.        Exp8    ::= Exp8 "/" Exp9 ;
Mod.        Exp8    ::= Exp8 "%" Exp9 ;
Add.        Exp7    ::= Exp7 "+" Exp8 ;
Sub.        Exp7    ::= Exp7 "-" Exp8 ;
Eq.         Exp6    ::= Exp6 "=" Exp7 ;
Lt.         Exp6    ::= Exp6 "<" Exp7 ;
Gt.         Exp6    ::= Exp6 ">" Exp7 ;
Leq.        Exp6    ::= Exp6 TLeq Exp7 ;
Geq.        Exp6    ::= Exp6 TGeq Exp7 ;
Not.        Exp5    ::= TNot Exp6 ;
And.        Exp4    ::= Exp4 Conj Exp5 ;
Or.         Exp4    ::= Exp4 Disj Exp5 ;
Norm.       Exp3    ::= "normal" Exp4 ;
Ite.        Exp2    ::= "if" Exp2 "then" Exp3 "else" Exp3 ;
Match.      Exp1    ::= "match" Exp1 "{" "inL" Ident TMatch Exp2 ";" "inR" Ident TMatch Exp2 "}" ;
Rec.        Exp     ::= "fix" Ident "." Exp1 ;
LetIn.      Exp     ::= "let" Environment "in:" Exp1 ;
Abstr.      Exp     ::= Lam Ident "." Exp ;

coercions Exp 14 ;

Assign.     Assignment  ::= Ident TSub Exp ;
Env.        Environment ::= [ Assignment ] ;
terminator nonempty Assignment ";" ;
